{
	"name": "animehub",
	"version": "1.0.0",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-builder",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"build": {
		"appId": "com.animehub.app",
		"productName": "AnimeHub",
		"win": {
			"target": "nsis",
			"icon": "assets/logo.ico"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"createDesktopShortcut": "always",
			"createStartMenuShortcut": true
		}
	},
	"keywords": [],
	"author": "Jordan BUSQUET",
	"license": "ISC",
	"description": "AnimeHub is an app for listing all Anime !",
	"devDependencies": {
		"electron": "^40.10.2",
		"electron-builder": "^26.15.3"
	}
}
